# git-flow-next configuration for codetrail (decision 11), classic preset.
# Load it once per clone with: git flow config sync
# The feature.finish section keeps finishing local: no push, keep the remote branch,
# always a merge commit, no fetch. Release and hotfix finishes never tag, push or fetch; the
# founder releases and tags. Agents never change this file
# (AGENTS.md, Never do, rule 1).
[gitflow]
	version = 1.0
	initialized = true
[gitflow "branch.feature"]
	type = topic
	parent = develop
	startPoint = develop
	upstreamStrategy = merge
	downstreamStrategy = rebase
	prefix = feature/
	autoUpdate = false
	tag = false
[gitflow "branch.bugfix"]
	type = topic
	parent = develop
	startPoint = develop
	upstreamStrategy = merge
	downstreamStrategy = rebase
	prefix = bugfix/
	autoUpdate = false
	tag = false
[gitflow "branch.release"]
	type = topic
	parent = main
	startPoint = develop
	upstreamStrategy = merge
	downstreamStrategy = merge
	prefix = release/
	autoUpdate = false
	tag = true
[gitflow "branch.hotfix"]
	type = topic
	parent = main
	startPoint = main
	upstreamStrategy = merge
	downstreamStrategy = rebase
	prefix = hotfix/
	autoUpdate = false
	tag = true
[gitflow "branch.support"]
	type = topic
	parent = main
	startPoint = main
	upstreamStrategy = none
	downstreamStrategy = none
	prefix = support/
	autoUpdate = false
	tag = false
[gitflow "branch.main"]
	type = base
	upstreamStrategy = none
	downstreamStrategy = none
	autoUpdate = false
	tag = false
[gitflow "branch.develop"]
	type = base
	parent = main
	upstreamStrategy = merge
	downstreamStrategy = merge
	autoUpdate = true
	tag = false
[gitflow "release.finish"]
	notag = true
	push = false
	fetch = false
[gitflow "hotfix.finish"]
	notag = true
	push = false
	fetch = false
[gitflow "feature.finish"]
	push = false
	keepremote = true
	no-ff = true
	fetch = false
