{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git send-pack:*)",
      "Bash(git subtree push:*)",
      "Bash(git remote set-url:*)",
      "Bash(git credential:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo sync:*)",
      "Bash(gh auth token:*)",
      "Bash(gh auth git-credential:*)",
      "Bash(gh auth setup-git:*)",
      "Bash(gh pr new:*)",
      "Bash(gh repo new:*)",
      "Bash(az account get-access-token:*)",
      "Bash(glab config get token:*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(!**/.env.example)",
      "Read(~/.ssh/**)",
      "Read(./**/.dev.vars)",
      "Read(./**/*.p8)",
      "Read(./**/*.p12)",
      "Read(./**/*.pem)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.backup)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/Library/Preferences/.wrangler/**)",
      "Read(~/.wrangler/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.aws/**)",
      "Read(~/.git-credentials)",
      "Read(~/.config/git/credentials)",
      "Read(~/.terraform.d/**)",
      "Read(./**/*.tfvars)",
      "Read(./**/*.tfvars.json)",
      "Read(./**/*.key)",
      "Read(~/.pypirc)",
      "Read(~/.codex/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/glab-cli/**)",
      "Read(~/Library/Application Support/glab-cli/**)",
      "Edit(./.git/**)",
      "Write(./.git/**)"
    ],
    "ask": [
      "Edit(//**/AGENTS.md)",
      "Edit(//**/CLAUDE.md)",
      "Edit(//**/CLAUDE.local.md)",
      "Edit(//**/.mcp.json)",
      "Edit(//**/.claude/settings.json)",
      "Edit(//**/.claude/settings.local.json)",
      "Edit(//**/.claude/hooks/**)",
      "Edit(//**/.claude/agents/**)",
      "Edit(//**/.claude/commands/**)",
      "Edit(//**/.claude/skills/**)",
      "Edit(//**/.claude/rules/**)",
      "Edit(//**/.codex/**)",
      "Edit(//**/docs/security/**)",
      "Edit(//**/.github/**)",
      "Edit(//**/commitlint*.mjs)",
      "Edit(//**/justfile)",
      "Edit(//**/lefthook*.yml)",
      "Edit(//**/.mise.toml)",
      "Edit(//**/mise.toml)",
      "Edit(//**/.mise.local.toml)",
      "Edit(//**/mise.local.toml)",
      "Edit(//**/.config/mise*)",
      "Edit(//**/.config/mise/**)",
      "Edit(//**/tools/git-hooks/**)",
      "Edit(~/.claude/settings.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_push.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_secret_reads.py\""
          }
        ]
      }
    ]
  }
}
