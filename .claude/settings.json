{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git send-pack:*)",
      "Bash(git subtree push:*)",
      "Bash(git remote set-url:*)",
      "Bash(git credential:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo sync:*)",
      "Bash(gh auth token:*)",
      "Bash(gh auth git-credential:*)",
      "Bash(gh auth setup-git:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(~/.ssh/**)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.test)",
      "Read(./**/.dev.vars)",
      "Read(./**/*.p8)",
      "Read(./**/*.p12)",
      "Read(./**/*.pem)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.backup)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/Library/Preferences/.wrangler/**)",
      "Read(~/.wrangler/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.aws/**)",
      "Read(~/.git-credentials)",
      "Read(~/.config/git/credentials)",
      "Read(~/.terraform.d/**)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.dev)",
      "Read(./**/.env.prod)",
      "Read(./**/*.tfvars)",
      "Read(./**/*.tfvars.json)",
      "Read(./**/*.key)",
      "Read(~/.pypirc)",
      "Edit(./.git/**)",
      "Write(./.git/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_push.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_secret_reads.py\""
          }
        ]
      }
    ]
  }
}
