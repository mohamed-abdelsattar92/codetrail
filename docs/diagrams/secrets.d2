# What the assistant can see (README, "Secrets stay out"). Render with `just diagrams`.
direction: down

tracked: "Every tracked file at the commit"
builtin: "Built-in secret patterns\n.env · *.tfvars · *.pem · *.p8 · *.tfstate · id_rsa* …\nnothing can override these" {shape: diamond}
gone: "Not there" {shape: oval}
ignore: "Ignore files, gitignore syntax\n.codetrailignore in the repo\n+ your own targets/shop.ignore" {shape: diamond}
scan: "gitleaks content scan\nsecrets inside ordinary files" {shape: diamond}
source: "source/\nthe only files that exist for Codetrail"
guard: "Read-only tools\ninside source/ only" {shape: hexagon}
assistant: "Your assistant"
out: "Every page, answer and feedback\nscanned for secrets again" {shape: hexagon}

tracked -> builtin
builtin -> gone: excluded
builtin -> ignore
ignore -> gone: excluded
ignore -> scan
scan -> gone: flagged
scan -> source -> guard -> assistant -> out
