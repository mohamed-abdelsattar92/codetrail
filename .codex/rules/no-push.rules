# Codex rules for codetrail: coding agents never push (AGENTS.md, Never do, rule 1).
# Codex loads project rules once the project is trusted. The strictest matching rule wins.
# Codex treats compound shell commands (for example "cd x && git push") as one call that prefix
# rules may not match, so the git pre-push hook (tools/git-hooks/pre-push) is the backstop.
# Rules match literal tokens from the start of a command, so an option placed before the
# subcommand ("git -C . push", "git -P -P push") would hide it; the rules at the end refuse
# those or make Codex ask first, and Codex asks before every gh and glab command, whose
# leading flags can't be listed ("gh --hostname x auth token"). A flag placed later ("git commit -m x
# --no-verify") or an "=" form ("git --git-dir=.git push", "git --exec-path=x fetch") still
# isn't matched: the rules in AGENTS.md hold regardless.
# Check changes with: codex execpolicy check --rules <this file> <command>

prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "Agents never push in codetrail. Commit and finish features locally, then stop; the founder pushes.",
    match = ["git push", "git push origin develop", "git push --force origin main"],
    not_match = ["git status", "git commit -m x"],
)

prefix_rule(
    pattern = ["git", ["send-pack", "credential"]],
    decision = "forbidden",
    justification = "Agents never push or touch git credentials in codetrail.",
)

prefix_rule(
    pattern = ["git", "subtree", "push"],
    decision = "forbidden",
    justification = "Agents never push in codetrail.",
)

prefix_rule(
    pattern = ["git", "remote", ["add", "set-url", "rename", "remove", "rm"]],
    decision = "forbidden",
    justification = "Agents never change git remotes in codetrail.",
)

prefix_rule(
    pattern = ["gh", "pr", ["create", "new", "merge", "close", "reopen", "edit", "comment", "review", "ready"]],
    decision = "forbidden",
    justification = "Agents never open, merge or change pull requests; the founder does.",
)

prefix_rule(
    pattern = ["gh", "repo", ["sync", "create", "new", "delete", "edit", "rename", "archive", "fork"]],
    decision = "forbidden",
    justification = "Agents never change GitHub repositories.",
)

prefix_rule(
    pattern = ["gh", "auth", ["token", "git-credential", "setup-git", "login", "logout", "refresh"]],
    decision = "forbidden",
    justification = "Agents never read or change GitHub credentials.",
)

prefix_rule(
    pattern = ["gh", "auth", "status", ["-t", "--show-token"]],
    decision = "forbidden",
    justification = "Agents never print a hosting service's token.",
)

prefix_rule(
    pattern = ["glab", "auth", "status", ["-t", "--show-token"]],
    decision = "forbidden",
    justification = "Agents never print a hosting service's token.",
)

prefix_rule(
    pattern = ["glab", "config", "get", "token"],
    decision = "forbidden",
    justification = "Agents never print a hosting service's token.",
)

prefix_rule(
    pattern = ["az", "account", "get-access-token"],
    decision = "forbidden",
    justification = "Agents never print an Azure token.",
)

prefix_rule(
    pattern = ["git", "flow", ["feature", "bugfix", "release", "hotfix", "support"], ["publish", "delete"]],
    decision = "forbidden",
    justification = "Agents never publish git-flow branches (that pushes) or delete them; git flow feature finish removes a finished branch.",
    match = ["git flow feature publish x", "git flow feature delete x"],
    not_match = ["git flow feature finish x --no-ff --no-push --keepremote --no-fetch"],
)

prefix_rule(
    pattern = ["git-flow", ["feature", "bugfix", "release", "hotfix", "support"], ["publish", "delete"]],
    decision = "forbidden",
    justification = "Agents never publish git-flow branches (that pushes) or delete them.",
)

prefix_rule(
    pattern = ["git", "flow", ["release", "hotfix"], "finish"],
    decision = "forbidden",
    justification = "Agents never finish releases or hotfixes, which merge into main; the founder does.",
)

prefix_rule(
    pattern = ["git", ["commit", "merge"], ["--no-verify", "-n"]],
    decision = "forbidden",
    justification = "Agents never skip the git hooks (AGENTS.md, Never do, rule 8). Fix what the hook reports.",
)

prefix_rule(
    pattern = ["git", "commit", ["-nm", "-an", "-na", "-anm", "-nam"]],
    decision = "forbidden",
    justification = "Agents never skip the git hooks (AGENTS.md, Never do, rule 8); -n bundled with other short flags is --no-verify.",
    match = ["git commit -nm x", "git commit -anm x"],
    not_match = ["git commit -am x"],
)

prefix_rule(
    pattern = ["git", "pull", "--no-verify"],
    decision = "forbidden",
    justification = "Agents never skip the git hooks (AGENTS.md, Never do, rule 8); git pull --no-verify skips them on its merge commit.",
    match = ["git pull --no-verify origin develop"],
    not_match = ["git pull -n"],
)

GIT_CONFIG_HOOKS_KEYS = ["core.hooksPath", "core.hookspath", "core.HooksPath", "core.Hookspath", "CORE.HOOKSPATH"]
GIT_CONFIG_OPTIONS_WITHOUT_VALUE = ["--local", "--worktree", "--global", "--system", "set", "--add", "--replace-all", "--append", "--all", "--path"]
GIT_CONFIG_OPTIONS_WITH_VALUE = ["-f", "--file", "--blob", "--comment", "--type"]

prefix_rule(
    pattern = ["git", "config", GIT_CONFIG_HOOKS_KEYS],
    decision = "forbidden",
    justification = "Changing core.hooksPath turns off every git hook, the pre-push agent guard included (AGENTS.md, Never do, rule 8).",
    match = ["git config core.hooksPath /dev/null", "git config core.HooksPath x"],
    not_match = ["git config user.name"],
)

prefix_rule(
    pattern = ["git", "config", GIT_CONFIG_OPTIONS_WITHOUT_VALUE, GIT_CONFIG_HOOKS_KEYS],
    decision = "forbidden",
    justification = "Changing core.hooksPath turns off every git hook, the pre-push agent guard included (AGENTS.md, Never do, rule 8).",
    match = ["git config --local core.hooksPath /dev/null", "git config set core.hooksPath x"],
    not_match = ["git config --local user.name x"],
)

prefix_rule(
    pattern = ["git", "config", GIT_CONFIG_OPTIONS_WITHOUT_VALUE, GIT_CONFIG_OPTIONS_WITHOUT_VALUE + GIT_CONFIG_OPTIONS_WITH_VALUE],
    decision = "prompt",
    justification = "A second option before the key would hide a core.hooksPath change from the rule above.",
    match = ["git config set --local core.hooksPath x", "git config set --append core.hooksPath x", "git config --local -f x core.hooksPath y"],
    not_match = ["git config --get user.name"],
)

prefix_rule(
    pattern = ["git", "config", GIT_CONFIG_OPTIONS_WITH_VALUE],
    decision = "prompt",
    justification = "An option with a value before the key would hide a core.hooksPath change from the rules above.",
    match = ["git config -f .git/config core.hooksPath /dev/null", "git config --file x core.hooksPath y"],
    not_match = ["git config -l"],
)

GIT_OPTIONS_WITH_VALUE = ["-C", "-c", "--git-dir", "--work-tree", "--config-env", "--namespace", "--shallow-file", "--attr-source"]
GIT_OPTIONS_WITHOUT_VALUE = ["-p", "--paginate", "-P", "--no-pager", "--bare", "--no-replace-objects", "--no-lazy-fetch", "--no-optional-locks", "--no-advice", "--literal-pathspecs", "--no-literal-pathspecs", "--glob-pathspecs", "--noglob-pathspecs", "--icase-pathspecs"]

prefix_rule(
    pattern = ["git", GIT_OPTIONS_WITHOUT_VALUE, ["push", "send-pack", "credential"]],
    decision = "forbidden",
    justification = "Agents never push or touch git credentials in codetrail, with or without an option before the subcommand.",
    match = ["git --no-pager push --no-verify origin develop", "git -P credential fill"],
    not_match = ["git --no-pager log", "git -P diff"],
)

prefix_rule(
    pattern = ["git", GIT_OPTIONS_WITHOUT_VALUE, ["remote", "subtree", "config", "am", "pull", "commit", "merge", "flow"]],
    decision = "prompt",
    justification = "An option before the git subcommand hides it from these rules (git -P commit -n, git -P remote set-url). Run it with nothing before the subcommand.",
    match = ["git -P commit -n -m x", "git --no-pager remote set-url origin x"],
    not_match = ["git --no-pager log", "git -P diff"],
)

prefix_rule(
    pattern = ["git", GIT_OPTIONS_WITHOUT_VALUE, GIT_OPTIONS_WITHOUT_VALUE + GIT_OPTIONS_WITH_VALUE],
    decision = "prompt",
    justification = "Two or more options before the git subcommand hide it from these rules (git -P -P push, git --no-pager -C . push).",
    match = ["git -P -P push --no-verify origin develop", "git --no-pager -C . push", "git -P --bare credential fill"],
    not_match = ["git --no-pager log", "git -P diff"],
)

prefix_rule(
    pattern = ["git", "am", ["--no-verify", "-n"]],
    decision = "forbidden",
    justification = "Agents never skip the git hooks (AGENTS.md, Never do, rule 8). Fix what the hook reports.",
    match = ["git am -n x.patch", "git am --no-verify x.patch"],
    not_match = ["git am x.patch"],
)

prefix_rule(
    pattern = ["git", GIT_OPTIONS_WITH_VALUE],
    decision = "prompt",
    justification = "An option with a value before the git subcommand hides it from these rules (git -C . push, git -c core.hooksPath=x commit). Run git from the folder, with nothing before the subcommand.",
    match = ["git -C . push", "git -c core.hooksPath=/dev/null commit -m x", "git --git-dir .git push"],
    not_match = ["git status", "git log -C"],
)

prefix_rule(
    pattern = [["gh", "glab"]],
    decision = "prompt",
    justification = "gh and glab find their subcommand past any flag placed first (gh --hostname x auth token, gh --visibility public repo edit), which no list of flags can cover; Codex asks before each one, and the rules above still refuse the writes and token printers they name.",
    match = ["gh --hostname github.com auth token", "gh --visibility public repo edit", "gh --subject s pr merge 1", "glab --host gitlab.com config get token", "gh pr view 1"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["gh", "api"],
    decision = "prompt",
    justification = "Read-only GitHub API calls only; any write to GitHub is forbidden for agents.",
)
