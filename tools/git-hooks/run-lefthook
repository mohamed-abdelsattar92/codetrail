#!/bin/sh
# Runs one lefthook hook for codetrail (lefthook.yml, ADR 0004). The git hooks call it.
# It loads the mise-pinned tools even when the shell hasn't activated mise, never lets lefthook
# reinstall hooks, and fails closed when lefthook can't be found.
hook="$1"
shift
root=$(git rev-parse --show-toplevel)

if [ ! -f "$root/lefthook.yml" ]; then
  echo "$hook: lefthook.yml is missing, so the checks can't run; restore it before committing or pushing." >&2
  exit 1
fi

if command -v mise >/dev/null 2>&1; then
  eval "$(cd "$root" && mise env --shell bash 2>/dev/null)"
fi

if ! command -v lefthook >/dev/null 2>&1; then
  echo "$hook: lefthook not found. Run 'mise trust && mise install' and 'just setup' in the repository." >&2
  exit 1
fi

exec lefthook run --no-auto-install "$hook" "$@"
